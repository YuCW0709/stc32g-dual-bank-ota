/*==============================================================================
 *  app_secrets.h.example  --  本地私密配置的**模板**
 *
 *  为什么单独一个文件：
 *    broker 地址、用户名、密码、clientid 都是**每个部署独有**的东西。
 *    把它们写进 app_config.h 会让"公开仓库"和"能跑固件"变成互相矛盾 ——
 *    要么泄露凭据，要么 clone 下来编不过。
 *    所以真实值放 app_secrets.h（已在 .gitignore 里排除），仓库只留本模板。
 *
 *  用法：
 *      cp APP/app_secrets.h.example APP/app_secrets.h
 *      然后按下面注释填自己的值（app_secrets.h 不会被 git 跟踪）
 *
 *  ★ 别把填好的 app_secrets.h 提交上去。检查一下：
 *      git status --short | grep app_secrets      ← 只应出现 .example
 *============================================================================*/
#ifndef __APP_SECRETS_H
#define __APP_SECRETS_H

/*----------------------------------------------------------------------------
 * 1. MQTT broker
 *
 *    EMQX Serverless 的接入地址形如：
 *        <instance-id>.ala.cn-shenzhen.emqxsl.cn         （深圳区）
 *        <instance-id>.ala.ap-southeast-1.emqxsl.cn      （新加坡区）
 *    TLS 端口 8883（8883 = TLS，1883 = 明文）。
 *
 *    ★ 只用域名，不要填 IP：MQTT over TLS 必须发 SNI
 *      （AT+SSLCFG="hostname",88,"<域名>"），填 IP 会导致 MQNCCONNECT 永远收不到 CONNACK。
 *--------------------------------------------------------------------------*/
#define APP_SECRET_MQTT_HOST       "your-instance.ala.cn-shenzhen.emqxsl.cn"
#define APP_SECRET_MQTT_PORT       8883

/*----------------------------------------------------------------------------
 * 2. 账号
 *    EMQX Serverless 的控制台里可以建"客户端认证"用户。
 *    测试期也可以用内置的默认用户，但**不要**把真实密码提交到仓库。
 *--------------------------------------------------------------------------*/
#define APP_SECRET_MQTT_USER       "your_username"
#define APP_SECRET_MQTT_PASS       "your_password"

/*----------------------------------------------------------------------------
 * 3. 客户端 ID
 *
 *    ★ 必须全网唯一，否则后连的会把先连的踢下线（模组手册 16.1 明确说明）。
 *    建议格式：<产品>_<项目>_<编号>，例如 stc32g_demo_0001。
 *    同时把设备号体现在主题里，方便一台设备一个通道。
 *--------------------------------------------------------------------------*/
#define APP_SECRET_MQTT_CLIENT_ID  "stc32g_demo_0001"

#endif /* __APP_SECRETS_H */
